{
  "name": "@velor/remote-mouse",
  "version": "6.19.89",
  "engines": {
    "node": ">=22.14.0"
  },
  "type": "module",
  "description": "Remote mouse and keyboard with mobile client",
  "homepage": "https://github.com/glennerichall/node-mouse#readme",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/glennerichall/node-mouse.git"
  },
  "bugs": {
    "url": "https://github.com/glennerichall/node-mouse/issues"
  },
  "bin": {
    "remote-mouse": "./bin/remote-mouse.js"
  },
  "files": [
    ".env.example",
    "bin/",
    "client/",
    "index.js",
    "native/",
    "prebuilds/",
    "public/",
    "server/",
    "scripts/build-native-prebuilds.mjs",
    "scripts/build-uinput-bridge.sh",
    "scripts/build-wayland-helper.sh",
    "scripts/build-xwayland-overlay.sh",
    "scripts/install-gnome-focus-extension.sh",
    "scripts/configure-uinput-access.sh",
    "scripts/configure-uinput-after-update.mjs",
    "scripts/postinstall-linux.mjs",
    "utils/"
  ],
  "scripts": {
    "predev": "node scripts/build-dev-native.mjs",
    "start": "node index.js",
    "dev": "node scripts/start-dev.mjs",
    "build:wayland": "bash scripts/build-wayland-helper.sh",
    "build:xwayland-overlay": "bash scripts/build-xwayland-overlay.sh",
    "install:gnome-focus": "bash scripts/install-gnome-focus-extension.sh",
    "build:uinput": "bash scripts/build-uinput-bridge.sh",
    "build:native:prebuild": "node scripts/build-native-prebuilds.mjs",
    "verify:native:prebuilds": "node scripts/verify-native-prebuilds.mjs",
    "verify:package": "node scripts/verify-npm-package.mjs",
    "prepublishOnly": "node scripts/prepare-npm-publish.mjs",
    "setup:dev:linux": "bash dev/setup-linux.sh",
    "postinstall": "node scripts/postinstall-linux.mjs",
    "check:version": "node scripts/check-package-version.mjs",
    "test": "npm run check:version && NODE_OPTIONS=--experimental-vm-modules jest --runInBand --coverage",
    "test:install": "node --experimental-vm-modules node_modules/jest/bin/jest.js test/unit/setup-command.test.js test/unit/windows-daemon-service.test.js --runInBand",
    "test:install:integration": "node test/integration/install/run-linux-install.mjs",
    "test:all": "npm test && npm run test:e2e",
    "test:e2e": "playwright test",
    "screenshots:mobile": "node scripts/generate-mobile-screenshots.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.3.1",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "joi": "^18.2.9",
    "node-notifier": "^10.0.1",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "proxy-addr": "2.0.8",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "robotjs": "^0.9.1",
    "router": "^2.2.0",
    "samsung-tv-remote": "^3.0.4",
    "socket.io": "^4.8.1",
    "yargs": "^15.4.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "jest": "^30.3.0",
    "sinon": "^21.0.3"
  },
  "overrides": {
    "express": {
      "qs": "~6.16.0"
    }
  }
}
