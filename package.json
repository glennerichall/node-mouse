{
  "name": "@velor/remote-mouse",
  "version": "6.19.20",
  "type": "module",
  "description": "Remote mouse and keyboard with mobile client",
  "homepage": "https://github.com/glennerichall/node-mouse#readme",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/glennerichall/node-mouse.git"
  },
  "bugs": {
    "url": "https://github.com/glennerichall/node-mouse/issues"
  },
  "bin": {
    "remote-mouse": "./bin/remote-mouse.js"
  },
  "scripts": {
    "start": "node index.js",
    "dev": "node index.js",
    "build:wayland": "bash scripts/build-wayland-helper.sh",
    "build:xwayland-pointer": "bash scripts/build-xwayland-pointer-bridge.sh",
    "build:xwayland-overlay": "bash scripts/build-xwayland-overlay.sh",
    "build:uinput": "bash scripts/build-uinput-bridge.sh",
    "postinstall": "node scripts/build-native-input-if-available.mjs",
    "check:version": "node scripts/check-package-version.mjs",
    "test": "npm run check:version && NODE_OPTIONS=--experimental-vm-modules jest --runInBand --coverage",
    "test:install": "NODE_OPTIONS=--experimental-vm-modules jest test/unit/install-scripts.test.js --runInBand",
    "test:install:integration": "node test/integration/install/run-linux-install.mjs",
    "test:integration": "npm run test:remote",
    "test:remote": "node test/integration/run-remote.mjs linux-install",
    "test:remote:x11": "node test/integration/run-remote.mjs linux-x11",
    "test:remote:wayland": "node test/integration/run-remote.mjs linux-wayland",
    "deploy:linux": "bash dev/deploy/deploy-linux.sh install",
    "deploy:linux:x11": "bash dev/deploy/deploy-linux.sh x11",
    "deploy:linux:wayland": "bash dev/deploy/deploy-linux.sh wayland",
    "test:all": "npm test && npm run test:e2e && npm run test:integration",
    "test:e2e": "playwright test",
    "screenshots:mobile": "node scripts/generate-mobile-screenshots.mjs",
    "commit:codex": "bash scripts/codex-commit.sh"
  },
  "dependencies": {
    "@hurdlegroup/robotjs": "^0.12.3",
    "better-sqlite3": "^12.8.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.3.1",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "joi": "^18.2.9",
    "node-notifier": "^10.0.1",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "proxy-addr": "^2.0.7",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "samsung-tv-remote": "^3.0.4",
    "socket.io": "^4.8.1",
    "yargs": "^15.4.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "jest": "^30.3.0",
    "sinon": "^21.0.3"
  },
  "overrides": {
    "express": {
      "qs": "~6.16.0"
    }
  }
}
