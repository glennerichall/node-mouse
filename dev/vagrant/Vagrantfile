# frozen_string_literal: true

laboratory_directory = __dir__
repository_directory = File.expand_path("../..", laboratory_directory)
windows_package = Dir[File.join(laboratory_directory, "artifacts/velor-remote-mouse-*.tgz")].max ||
  File.join(laboratory_directory, "artifacts/MISSING-run-npm-run-vm-pack-windows.tgz")

Vagrant.configure("2") do |config|
  config.vm.synced_folder ".", "/vagrant", disabled: true

  config.vm.define "linux-install" do |guest|
    guest.vm.box = "cloud-image/ubuntu-24.04"
    guest.vm.box_version = "20260926.0.0"
    guest.vm.hostname = "remote-mouse-install"
    guest.vm.synced_folder repository_directory, "/workspace/remote-mouse",
      type: "rsync",
      rsync__exclude: ["/.git/", "/node_modules/", "/build/", "/coverage/", "/.data/"]
    guest.vm.provider :libvirt do |provider|
      provider.driver = "kvm"
      provider.cpus = 2
      provider.memory = 4096
      provider.storage_pool_name = "default"
    end

    guest.vm.provision "shell", name: "prepare-linux",
      path: File.join(laboratory_directory, "provision/prepare-linux-install.sh")
    guest.vm.provision "shell", name: "install-remote-mouse", privileged: false,
      path: File.join(laboratory_directory, "provision/install-remote-mouse.sh")
  end

  config.vm.define "linux-x11" do |guest|
    guest.vm.box = "cloud-image/ubuntu-24.04"
    guest.vm.box_version = "20260926.0.0"
    guest.vm.hostname = "remote-mouse-x11"
    guest.vm.synced_folder repository_directory, "/workspace/remote-mouse",
      type: "rsync",
      rsync__exclude: ["/.git/", "/node_modules/", "/build/", "/coverage/", "/.data/"]

    guest.vm.provider :libvirt do |provider|
      provider.driver = "kvm"
      provider.cpus = 2
      provider.memory = 4096
      provider.video_type = "virtio"
      provider.graphics_type = "spice"
      provider.storage_pool_name = "default"
    end

    guest.vm.provision "shell", name: "prepare-x11",
      path: File.join(laboratory_directory, "provision/prepare-linux-x11.sh")
    guest.vm.provision "shell", name: "install-remote-mouse-x11", privileged: false,
      path: File.join(laboratory_directory, "provision/install-remote-mouse-x11.sh")
  end

  config.vm.define "linux-wayland" do |guest|
    guest.vm.box = "cloud-image/ubuntu-24.04"
    guest.vm.box_version = "20260926.0.0"
    guest.vm.hostname = "remote-mouse-wayland"
    guest.vm.synced_folder repository_directory, "/workspace/remote-mouse",
      type: "rsync",
      rsync__exclude: ["/.git/", "/node_modules/", "/build/", "/coverage/", "/.data/"]

    guest.vm.provider :libvirt do |provider|
      provider.driver = "kvm"
      provider.cpus = 4
      provider.memory = 6144
      provider.video_type = "virtio"
      provider.graphics_type = "spice"
      provider.storage_pool_name = "default"
    end

    guest.vm.provision "shell", name: "prepare-wayland",
      path: File.join(laboratory_directory, "provision/prepare-linux-wayland.sh")
    guest.vm.provision "shell", name: "install-remote-mouse-wayland", privileged: false,
      path: File.join(laboratory_directory, "provision/install-remote-mouse-wayland.sh")
  end

  config.vm.define "windows-11", autostart: false do |guest|
    guest.vm.box = ENV.fetch("REMOTE_MOUSE_WINDOWS_BOX", "remote-mouse/windows-11")
    guest.vm.hostname = "remote-mouse-win11"
    guest.vm.communicator = "winrm"
    guest.vm.guest = :windows
    guest.winrm.transport = :plaintext
    guest.winrm.basic_auth_only = true
    if File.file?(windows_package)
      guest.vm.provision "file", source: windows_package,
        destination: "C:/Windows/Temp/remote-mouse.tgz"
      guest.vm.provision "file", source: File.join(repository_directory, "scripts/install-windows.ps1"),
        destination: "C:/Windows/Temp/install-remote-mouse.ps1"
      guest.vm.provision "shell", name: "install-remote-mouse-windows",
        path: File.join(laboratory_directory, "provision/install-remote-mouse-windows.ps1")
    else
      guest.vm.provision "shell", name: "missing-windows-package",
        inline: "throw 'Missing npm artifact. Run npm run vm:pack:windows before provisioning windows-11.'"
    end

    guest.vm.provider :libvirt do |provider|
      provider.driver = "kvm"
      provider.cpus = 4
      provider.memory = 8192
      provider.storage_pool_name = "default"
      provider.loader = ENV.fetch("REMOTE_MOUSE_UEFI_LOADER", "/usr/share/OVMF/OVMF_CODE_4M.ms.fd")
      provider.tpm_model = "tpm-crb"
      provider.tpm_type = "emulator"
      provider.tpm_version = "2.0"
    end
  end
end
